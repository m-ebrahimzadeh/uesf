{
  "name": "uesf",
  "version": "0.9.3",
  "description": "Universal Engineering Skills Framework (UESF) — Reusable Multi-Agent Engineering Roles, Workflows, and Context Control Plane",
  "type": "module",
  "bin": {
    "uesf": "./bin/uesf.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "scripts/"
  ],
  "scripts": {
    "install-skills": "node ./bin/uesf.mjs install",
    "update-skills": "node ./bin/uesf.mjs update",
    "uninstall-skills": "node ./bin/uesf.mjs uninstall",
    "check": "node ./bin/uesf.mjs check",
    "doctor": "node ./bin/uesf.mjs doctor",
    "init-project": "node ./bin/uesf.mjs init-project",
    "build-dist": "node ./bin/uesf.mjs build",
    "sync-snapshot": "node ./bin/uesf.mjs sync-snapshot"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-ebrahimzadeh/uesf.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
